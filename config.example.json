{
  "port": 4317,
  "lan": false,
  "pollMs": 2000,
  "lang": "en",

  "dataDir": null,
  "opencodeConfigDir": null,

  "lookbackHours": 24,
  "maxSessions": 30,

  "thresholds": {
    "stuckToolMinutes": 10,
    "stuckToolMinutesByTool": { "task": 60 },
    "silentMinutes": 10,
    "contextWarnPct": 80,
    "compactWarnPct": 85,
    "compactWarnRequests": 3,
    "compactionWarn": 3,
    "sessionAgeWarnHours": 6,
    "repeatWarn": 3,
    "repeatWindow": 30,
    "toolErrorWarn": 10
  },

  "contextLimit": {
    "default": null,
    "models": { "my-provider/my-model": 131072 }
  },

  "processNames": ["opencode"],

  "redact": {
    "enabled": true,
    "extraPatterns": []
  },

  "environment": {
    "checkSeconds": 15,
    "modelServers": "local"
  },

  "services": [
    { "name": "dev server", "url": "http://localhost:3000" },
    { "name": "postgres", "host": "localhost", "port": 5432 }
  ],

  "work": {
    "git": true,
    "processes": true,
    "protectedBranches": ["main", "master"]
  },

  "review": {
    "ignoreRules": []
  },

  "history": {
    "enabled": true,
    "file": "data/history.jsonl",
    "retentionDays": 30
  },

  "notify": {
    "on": ["waiting", "stuck"],
    "environment": true,
    "repeatMinutes": 30,
    "desktop": true,
    "discord": {
      "webhookUrl": "",
      "mention": "",
      "includeDetail": false
    },
    "weekly": {
      "enabled": false,
      "weekday": 1,
      "hour": 9
    }
  }
}
